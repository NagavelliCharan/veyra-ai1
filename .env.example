# Veyra AI Secure Backend Server Environment Variables
# Copy this file to .env and insert your personal API keys:
# copy .env.example .env

# Server port (default: 3001)
PORT=3001

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Supports both traditional AIza... keys and modern AQ... Auth keys
# NOTE: This key is read ONLY on the server and is NEVER exposed to the frontend browser bundle.
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud API Key from Groq Console (optional secondary provider: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Sign-In OAuth Client ID (public, used by both the frontend and backend)
# Create one at https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized JavaScript origins: http://localhost:5173 (and your production domain)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# MongoDB Atlas Persistent Metadata Database URI (optional - falls back to persistent disk storage)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@your-cluster.mongodb.net/privy_ai?retryWrites=true&w=majority&appName=Cluster0
